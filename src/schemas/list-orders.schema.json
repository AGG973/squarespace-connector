{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AGG973/squarespace-connector/schemas/list-orders.schema.json",
  "title": "squarespace.list_orders",
  "description": "Input/output contract for listing orders. GET /orders on the commerce base URL (https://api.squarespace.com/1.0/commerce). VERIFICATION STATUS: the response envelope is verified against fixtures/orders.json — note the top-level array key is `result`, NOT `orders`, unlike list_products (`products`) and get_contact's list form (`contacts`). The per-order fields are now CONFIRMED live, 2026-08-16, against a real populated order — the store had zero orders when the envelope was first verified, but list_orders has since been re-run against the real order created via create_order that same day. The populated response exactly matches create_order's captured response shape (same fields, same nesting, same line-item shape) — see fixtures/orders.json and fixtures/create-order-response.json. One confirmed difference from create_order's output: list_orders' per-order objects do NOT include an `idempotencyKey` field — that field is specific to the create_order response.",
  "type": "object",
  "required": ["input", "output"],
  "properties": {
    "input": {
      "title": "ListOrdersInput",
      "type": "object",
      "description": "All fields optional. `cursor` and the modifiedAfter/modifiedBefore time-range window are two mutually exclusive paging strategies and can't be combined; that's the only cross-field restriction confirmed against real Squarespace behavior. `limit` and `fulfillmentStatus` may accompany either paging strategy, and modifiedAfter/modifiedBefore are not required to be paired — an unconfirmed restriction that was removed.",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque cursor from a previous response's pagination.nextPageCursor."
        },
        "limit": { "type": "integer", "minimum": 1 },
        "modifiedAfter": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601. May be used alone or alongside modifiedBefore."
        },
        "modifiedBefore": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601. May be used alone or alongside modifiedAfter."
        },
        "fulfillmentStatus": { "$ref": "#/$defs/fulfillmentStatus" }
      },
      "dependentSchemas": {
        "cursor": {
          "description": "When paging by cursor, modifiedAfter/modifiedBefore may not also be sent — cursor and the time-range window are mutually exclusive paging strategies. limit and fulfillmentStatus are unaffected.",
          "not": {
            "anyOf": [
              { "required": ["modifiedAfter"] },
              { "required": ["modifiedBefore"] }
            ]
          }
        }
      }
    },
    "output": {
      "title": "ListOrdersResult",
      "type": "object",
      "required": ["result", "pagination"],
      "properties": {
        "result": {
          "type": "array",
          "description": "Verified key name — the orders endpoint uses `result`, not `orders`.",
          "items": { "$ref": "#/$defs/order" }
        },
        "pagination": { "$ref": "#/$defs/pagination" }
      }
    }
  },
  "examples": [
    {
      "input": {
        "modifiedAfter": "2026-01-01T00:00:00.000Z",
        "modifiedBefore": "2026-08-08T00:00:00.000Z",
        "fulfillmentStatus": "PENDING"
      },
      "output": {
        "result": [
          {
            "id": "6813b0c8f4a2b10001f3aa01",
            "orderNumber": "1",
            "createdOn": "2026-06-14T09:22:41.000Z",
            "modifiedOn": "2026-06-14T09:22:41.000Z",
            "testmode": false,
            "customerEmail": "buyer@example.com",
            "fulfillmentStatus": "PENDING",
            "billingAddress": {
              "firstName": "Ada",
              "lastName": "Lovelace",
              "address1": "123 Example St",
              "address2": null,
              "city": "Brooklyn",
              "state": "NY",
              "countryCode": "US",
              "postalCode": "11201",
              "phone": "555-0100"
            },
            "shippingAddress": {
              "firstName": "Ada",
              "lastName": "Lovelace",
              "address1": "123 Example St",
              "address2": null,
              "city": "Brooklyn",
              "state": "NY",
              "countryCode": "US",
              "postalCode": "11201",
              "phone": "555-0100"
            },
            "lineItems": [
              {
                "id": "6813b0c8f4a2b10001f3aa02",
                "variantId": "627d44e9-3f68-4ea4-a34b-794dcbbbc6db",
                "sku": "SQ5971216",
                "productName": "Test Product — Canvas Tote Bag",
                "quantity": 2,
                "unitPricePaid": { "currency": "USD", "value": "25.00" }
              }
            ],
            "subtotal": { "currency": "USD", "value": "50.00" },
            "shippingTotal": { "currency": "USD", "value": "5.00" },
            "discountTotal": { "currency": "USD", "value": "0.00" },
            "taxTotal": { "currency": "USD", "value": "4.44" },
            "refundedTotal": { "currency": "USD", "value": "0.00" },
            "grandTotal": { "currency": "USD", "value": "59.44" }
          }
        ],
        "pagination": {
          "nextPageUrl": null,
          "nextPageCursor": null,
          "hasNextPage": false
        }
      }
    },
    {
      "input": {},
      "output": {
        "result": [],
        "pagination": {
          "nextPageUrl": null,
          "nextPageCursor": null,
          "hasNextPage": false
        }
      }
    }
  ],
  "$defs": {
    "pagination": {
      "title": "Pagination",
      "type": "object",
      "description": "Cursor pagination envelope. Verified against fixtures/orders.json.",
      "required": ["nextPageUrl", "nextPageCursor", "hasNextPage"],
      "properties": {
        "nextPageUrl": { "type": ["string", "null"], "format": "uri" },
        "nextPageCursor": { "type": ["string", "null"] },
        "hasNextPage": { "type": "boolean" }
      }
    },
    "money": {
      "title": "Money",
      "type": "object",
      "required": ["currency", "value"],
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "value": { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?$" }
      }
    },
    "fulfillmentStatus": {
      "type": "string",
      "enum": ["PENDING", "FULFILLED", "CANCELED"],
      "description": "UNVERIFIED enum members — confirm against a live order before relying on these values."
    },
    "address": {
      "title": "Address",
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "address1": { "type": "string" },
        "address2": { "type": ["string", "null"] },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "postalCode": { "type": "string" },
        "phone": { "type": "string" }
      }
    },
    "lineItem": {
      "title": "OrderLineItem",
      "type": "object",
      "description": "CONFIRMED live, 2026-08-16, against a real order's response via list_orders — matches create_order's captured line-item shape exactly.",
      "required": ["id", "quantity"],
      "properties": {
        "id": { "type": "string" },
        "variantId": { "type": ["string", "null"], "format": "uuid" },
        "sku": { "type": ["string", "null"] },
        "productId": { "type": "string", "description": "CONFIRMED live, 2026-08-16." },
        "productName": { "type": "string" },
        "quantity": { "type": "integer", "minimum": 1 },
        "unitPricePaid": { "$ref": "#/$defs/money" },
        "lineItemType": { "type": "string", "description": "CONFIRMED live, 2026-08-16 — echoes the request's lineItemType, e.g. \"PHYSICAL_PRODUCT\"." },
        "weight": { "type": "number", "description": "CONFIRMED live, 2026-08-16." },
        "width": { "type": "number", "description": "CONFIRMED live, 2026-08-16." },
        "length": { "type": "number", "description": "CONFIRMED live, 2026-08-16." },
        "height": { "type": "number", "description": "CONFIRMED live, 2026-08-16." },
        "variantOptions": {
          "type": "array",
          "description": "CONFIRMED live, 2026-08-16.",
          "items": {
            "type": "object",
            "properties": {
              "optionName": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        },
        "customizations": { "type": ["array", "null"], "description": "CONFIRMED live, 2026-08-16 — null when the line item has none." },
        "imageUrl": { "type": "string", "description": "CONFIRMED live, 2026-08-16." }
      }
    },
    "order": {
      "title": "Order",
      "type": "object",
      "description": "CONFIRMED live, 2026-08-16, via list_orders against a real order — matches create_order's captured response shape exactly, except list_orders' per-order objects do NOT include idempotencyKey (that field is specific to the create_order response).",
      "required": ["id", "orderNumber", "createdOn", "lineItems", "grandTotal"],
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "createdOn": { "type": "string", "format": "date-time" },
        "modifiedOn": { "type": "string", "format": "date-time" },
        "testmode": { "type": "boolean" },
        "channel": { "type": "string", "description": "CONFIRMED live, 2026-08-16, e.g. \"external\"." },
        "channelName": { "type": "string" },
        "externalOrderReference": { "type": "string" },
        "customerEmail": { "type": "string", "format": "email" },
        "customerId": { "type": "string", "description": "CONFIRMED live, 2026-08-16." },
        "fulfillmentStatus": { "$ref": "#/$defs/fulfillmentStatus" },
        "fulfilledOn": { "type": ["string", "null"], "format": "date-time", "description": "CONFIRMED live, 2026-08-16 — null when unfulfilled." },
        "fulfillments": { "type": "array", "description": "CONFIRMED live, 2026-08-16 — empty array on an unfulfilled order." },
        "billingAddress": { "$ref": "#/$defs/address" },
        "shippingAddress": { "$ref": "#/$defs/address" },
        "lineItems": { "type": "array", "items": { "$ref": "#/$defs/lineItem" } },
        "internalNotes": { "type": "array", "description": "CONFIRMED live, 2026-08-16 — empty array observed; item shape not yet exercised." },
        "shippingLines": { "type": "array", "description": "CONFIRMED live, 2026-08-16 — empty array observed; item shape not yet exercised against a populated case." },
        "discountLines": { "type": "array", "description": "CONFIRMED live, 2026-08-16 — empty array observed; item shape not yet exercised." },
        "formSubmission": { "type": ["object", "null"], "description": "CONFIRMED live, 2026-08-16 — null observed; populated shape unconfirmed." },
        "priceTaxInterpretation": { "type": "string", "enum": ["EXCLUSIVE", "INCLUSIVE"] },
        "paymentState": { "type": "string", "description": "CONFIRMED live, 2026-08-16, e.g. \"PAID\". Other enum members unconfirmed." },
        "shippingOptionName": { "type": ["string", "null"], "description": "CONFIRMED live, 2026-08-16 — null observed." },
        "shippingOptionServiceType": { "type": ["string", "null"], "description": "CONFIRMED live, 2026-08-16 — null observed." },
        "subtotal": { "$ref": "#/$defs/money" },
        "shippingTotal": { "$ref": "#/$defs/money" },
        "discountTotal": { "$ref": "#/$defs/money" },
        "taxTotal": { "$ref": "#/$defs/money" },
        "refundedTotal": { "$ref": "#/$defs/money" },
        "grandTotal": { "$ref": "#/$defs/money" }
      }
    }
  }
}
