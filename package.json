{
  "name": "squarespace-connector",
  "version": "1.0.0",
  "description": "A typed connector for the Squarespace Commerce and Contacts APIs, exposed via an MCP server (stdio locally, Streamable HTTP when hosted).",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "typecheck": "tsc --noEmit",
    "check": "node --env-file-if-exists=.env src/check-connection.ts",
    "check:actions": "node --env-file-if-exists=.env src/check-actions.ts",
    "mcp": "node --env-file-if-exists=.env mcp/server.ts",
    "start": "node --env-file-if-exists=.env mcp/server.ts",
    "generate:openapi": "node src/generate-openapi.ts",
    "validate:openapi": "redocly lint openapi.yaml"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AGG973/squarespace-connector.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/AGG973/squarespace-connector/issues"
  },
  "homepage": "https://github.com/AGG973/squarespace-connector#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@redocly/cli": "^2.46.1",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
